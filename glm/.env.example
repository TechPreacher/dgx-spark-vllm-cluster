# Copy to glm/.env and fill in. glm/.env is gitignored by the repo's **/.env rule.
#
# HF_TOKEN     -- any read-scoped token from huggingface.co/settings/tokens.
#                 Neither model repo is gated, so there is nothing to accept; the
#                 token is for pull rate limits on a ~181 GiB download and for the
#                 launcher's required-var guard. The DFlash2 drafter
#                 (incoai/GLM-5.3-Flash-DFlash2, ENABLE_DFLASH2=1) is
#                 CC-BY-NC-ND-4.0 -- ungated, but still research / personal use
#                 only and never redistributed.
# VLLM_API_KEY -- the bearer token clients present to :8000.
HF_TOKEN=
VLLM_API_KEY=
