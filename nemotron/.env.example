# Copy to .env and populate. .env is gitignored via repo-root .gitignore.
#
#   cp .env.example .env
#   $EDITOR .env

# HuggingFace access token. Get one at https://huggingface.co/settings/tokens.
# Required to:
#   1. Pull nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4 weights into
#      ~/.cache/huggingface on first run (~60-80 GB FP4).
#   2. Fetch super_v3_reasoning_parser.py from the model repo via curl inside
#      the Ray container.
# Token must have "Read access to public gated repos" at minimum.
HF_TOKEN=

# vLLM API key (bearer token clients send to the OpenAI-compatible endpoint
# at http://<head>:8000). Any sufficiently long random string. Generate with:
#   openssl rand -hex 32
VLLM_API_KEY=
